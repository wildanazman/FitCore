# Server-only. Never prefix with VITE_ and never commit the real value.
GOOGLE_PLACES_API_KEY=
# Google Identity Services public web client ID; not your Gemini key.
GOOGLE_LOGIN_CLIENT_ID=
# Server-only verified Google-hosted admin emails. Never trust client-supplied roles.
GOOGLE_ADMIN_EMAILS=
# Conservative defaults; lower these if the project shares a billing account.
GOOGLE_PLACES_MONTHLY_REQUEST_LIMIT=250
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=10

# Optional operator-managed fallback endpoints.
OVERPASS_API_URL=
PHOTON_API_URL=
